# === EDA MCP 配置文件 ===
# 所有路径和连接参数集中在此，修改后重启服务即可生效。

# gRPC 服务地址（EDA-PMDS/EDI ExternalCall）
EDA_GRPC_SERVER=127.0.0.1:50055

# EDI 客户端可执行文件路径（留空自动检测: EDI.exe > EDA-PMDS.exe > CAIS.exe）
EDI_PATH=C:\Program Files (x86)\EDI\EDI.exe

# turbocharts 图表工具路径（留空自动检测: turbocharts_app.exe > TurboCharts.exe）
TURBOCHARTS_PATH=C:\Program Files (x86)\EDI\turbocharts_app.exe

# MCP 传输方式：stdio（桌面客户端）或 streamable-http（Web 客户端）
MCP_TRANSPORT=streamable-http

# streamable-http 模式监听端口（仅 start_servers.py 使用）
MCP_PORT=50026

# OpenClaw 工作区，show_image工具需要
OPENCLAW_WORKSPACE=C:\Users\JGL\.openclaw\workspace

# streamable-http 模式监听地址 （FastMCP 暴露的配置路由）
MCP_HOST=127.0.0.1


LLM_API_KEY=sk-6cb8bfafb2524d29b8dcf1fd64dc8fe0

LLM_BASE_URL=https://api.deepseek.com

LLM_MODEL=deepseek-v4-pro