# EDI MCP 配置模板 — 复制为 .env 后修改

# 本机 EDI gRPC 接口（EDI 启动后提供）
EDA_GRPC_SERVER=127.0.0.1:50055

# 本机 EDI 程序路径
EDI_PATH=C:\Program Files (x86)\EDI\EDI.exe

# 本机图表工具路径
TURBOCHARTS_PATH=C:\Program Files (x86)\EDI\turbocharts_app.exe

# MCP 传输方式：streamable-http（推荐）或 stdio
MCP_TRANSPORT=streamable-http

# HTTP 监听地址（本地模式保持 127.0.0.1）
MCP_HOST=127.0.0.1

# HTTP 监听端口
MCP_PORT=8000
