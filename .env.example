# === EDA MCP 配置文件 ===
# 复制为 .env 后修改，重启服务生效。

# gRPC 服务地址（EDA-PMDS/EDI ExternalCall）
EDA_GRPC_SERVER=127.0.0.1:50055

# EDI/TurboCharts 路径（留空自动检测: EDI.exe > EDA-PMDS.exe > CAIS.exe）
EDI_PATH=
TURBOCHARTS_PATH=

# MCP 传输方式：sse / streamable-http / stdio
MCP_TRANSPORT=sse
MCP_PORT=50026
MCP_HOST=127.0.0.1

# 可选。配置有效目录后注册 copy_image_to_workspace；不影响 show_image。
OPENCLAW_WORKSPACE=

# 可选。Chat AI 对话功能（LLM 多轮工具调用）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
